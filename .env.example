# ─────────────────────────────────────────────────────────────
# The Commonplace Book — environment variables
# Copy to .env.local for local work; add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public address of the site (no trailing slash). Used for canonical
# links, the sitemap, Open Graph images and Schema.org data.
NEXT_PUBLIC_SITE_URL=https://thecommonplacebook.in

# ── Database: MongoDB Atlas (free M0 cluster) ────────────────
# Without it the site runs on built-in sample content (good for previews).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=commonplace

# ── Writing desk sign-in (NextAuth + Google) ─────────────────
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=https://thecommonplacebook.in
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Only these Google accounts can open /desk (comma-separated).
DESK_ALLOWED_EMAIL=vandana@example.com
# Local development only: open the desk without Google (ignored in production).
DESK_DEV_BYPASS=false

# ── Images: Cloudinary (free plan) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Contact form emails: Resend ──────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Where contact messages are delivered (comma-separated for several).
CONTACT_TO_EMAIL=vandana@example.com
# Sender. Use onboarding@resend.dev until thecommonplacebook.in is verified in Resend,
# then switch to:  The Commonplace Book <hello@thecommonplacebook.in>
RESEND_FROM=The Commonplace Book <onboarding@resend.dev>

# ── Public details shown on the site (optional) ──────────────
# Shown under "To reach out". Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
# Profile links for Schema.org "sameAs" (comma-separated), e.g. LinkedIn, Instagram.
NEXT_PUBLIC_SAME_AS=

# ── Analytics & Search Console ───────────────────────────────
# GA4 measurement ID. Loaded only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# The content="" value of Search Console's HTML-tag verification.
NEXT_PUBLIC_GSC_VERIFICATION=
